# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables. Never commit real values.

# --- Required on Vercel --------------------------------------------------------

# Admin panel password (/admin). You can change it later in Admin → Settings;
# after that the password stored (hashed) in the database is used instead.
ADMIN_PASSWORD=

# Postgres. Created automatically when you add Neon from Vercel → Storage.
# Locally you can leave it empty: an embedded database is created in .data/pglite.
DATABASE_URL=

# File storage for plugin installers and product images. Created automatically
# when you add Blob from Vercel → Storage. Locally files go to .data/uploads.
BLOB_READ_WRITE_TOKEN=

# --- Email (veylixbim@gmail.com) -----------------------------------------------

# Gmail App Password for veylixbim@gmail.com (Google Account → Security →
# 2-Step Verification → App passwords). Enables order emails, trial keys,
# replies from the admin panel and new-message notifications.
GMAIL_APP_PASSWORD=

# Alternative to Gmail: Resend with your own verified domain.
RESEND_API_KEY=
EMAIL_FROM=
RESEND_AUDIENCE_ID=

# --- Optional -----------------------------------------------------------------

# Public address of the site, e.g. https://veylix.com. On Vercel the production
# domain is detected automatically; set this once you connect a custom domain.
NEXT_PUBLIC_SITE_URL=

# License signing key (PKCS#8 PEM, "\n" for newlines). Leave empty: a key is
# generated and kept in the database on first use.
LICENSE_PRIVATE_KEY=

# Admin session signing secret. Leave empty to use one generated in the database.
ADMIN_SESSION_SECRET=

# Seller details printed on tax invoices
SELLER_LEGAL_NAME=
SELLER_TAX_ID=
SELLER_ADDRESS="Cairo, Egypt"

# Social links shown in the footer (hidden when empty)
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_GITHUB_URL=

# Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Local development only: where the embedded database lives
PGLITE_DIR=
