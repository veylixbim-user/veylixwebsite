# Public site URL (used for canonical URLs, sitemap, hreflang, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://veylix.com

# Analytics (optional) — set one to enable
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=

# Payments — leave empty to run checkout in demo mode
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_IDS=
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
LEMONSQUEEZY_API_KEY=

# Email (optional) — Resend for transactional email + newsletter
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM="VEYLIX <hello@veylix.com>"
SALES_INBOX=sales@veylix.com

# Seller details printed on tax invoices
SELLER_LEGAL_NAME=
SELLER_TAX_ID=
SELLER_ADDRESS="Cairo, Egypt"

# Installer downloads (signed URLs)
DOWNLOAD_URL_SUITE=
DOWNLOAD_URL_MSI=
